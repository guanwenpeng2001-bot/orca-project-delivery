{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "record_reading",
        "title": "Record a temperature reading",
        "description": "Store one temperature reading for a named sensor.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sensor": { "type": "string" },
            "celsius": { "type": "number", "minimum": -89.2, "maximum": 56.7 }
          },
          "required": ["sensor", "celsius"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "stored": { "type": "boolean" }
          },
          "required": ["id", "stored"],
          "additionalProperties": false
        }
      }
    ]
  }
}
