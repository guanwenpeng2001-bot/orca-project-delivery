{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev Work Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "managedBy",
    "createdAt",
    "projectRoot"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "managedBy": {
      "const": "orca-project-delivery"
    },
    "createdAt": {
      "type": "string"
    },
    "projectRoot": {
      "type": "string"
    }
  },
  "additionalProperties": false
}