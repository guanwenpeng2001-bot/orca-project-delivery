{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "env"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "env": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[^\u0000]*$" }
    },
    "externalSkills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "requires": { "type": "object" }
        }
      }
    },
    "roleBindings": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defaultSkills", "optionalSkills"],
        "properties": {
          "defaultSkills": { "$ref": "#/$defs/skillIds" },
          "optionalSkills": { "$ref": "#/$defs/skillIds" }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": 1 } } },
    "then": { "not": { "anyOf": [{ "required": ["externalSkills"] }, { "required": ["roleBindings"] }] } }
  }],
  "$defs": {
    "skillIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
  }
}
