{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Active Run Pointer",
  "type": "object",
  "required": [
    "schemaVersion",
    "run",
    "runDirectory",
    "orcaRunId",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "runDirectory": {
      "type": "string",
      "minLength": 1
    },
    "orcaRunId": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
