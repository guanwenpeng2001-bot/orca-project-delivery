{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude Runtime Capabilities",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkedAt",
    "claudeCli",
    "combos"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "checkedAt": {
      "type": "string"
    },
    "routingFileHash": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "claudeCli": {
      "type": "object",
      "required": [
        "detected"
      ],
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelFlag": {
          "type": "boolean"
        },
        "effortFlag": {
          "type": "boolean"
        },
        "effortValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "combos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tier",
          "model",
          "verdict"
        ],
        "properties": {
          "tier": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "enum": [
              "accepted",
              "rejected",
              "unknown",
              "launched"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
