{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Run State",
  "type": "object",
  "required": [
    "schemaVersion",
    "runSlug",
    "objective",
    "workflow",
    "status",
    "stage",
    "deliveryBranch",
    "coordinatorWorktree",
    "completedStages",
    "pendingUserDecisions",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runSlug": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "enum": [
        "feature-development",
        "bug-fix",
        "refactor",
        "audit",
        "game-development"
      ]
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "completed",
        "failed",
        "abandoned"
      ]
    },
    "stage": {
      "type": "string"
    },
    "deliveryBranch": {
      "type": "string",
      "minLength": 1
    },
    "coordinatorControlBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "coordinatorWorktree": {
      "type": "string",
      "minLength": 1
    },
    "orcaRunId": {
      "type": [
        "string",
        "null"
      ]
    },
    "coordinatorModelReported": {
      "type": [
        "string",
        "null"
      ],
      "description": "用户主动说明的协调者模型；只记录，不校验、不作为路由输入。"
    },
    "completedStages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "stageDecisions": {
      "type": "object",
      "properties": {
        "design": {
          "type": "object",
          "required": [
            "verdict",
            "reason",
            "evidence",
            "decidedAt",
            "decidedBy"
          ],
          "properties": {
            "verdict": {
              "enum": ["required", "skipped"]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "decidedAt": {
              "type": "string"
            },
            "decidedBy": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "pendingUserDecisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}