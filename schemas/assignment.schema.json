{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker Assignment",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskKey",
    "role",
    "skills",
    "runtime",
    "branch",
    "artifacts",
    "orca",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskKey": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "object",
      "required": [
        "required",
        "conditional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object"
    },
    "branch": {
      "type": "object",
      "required": [
        "base",
        "work",
        "mergeTarget",
        "worktree"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "reportPath",
        "evidencePath"
      ]
    },
    "orca": {
      "type": "object",
      "required": [
        "runId",
        "taskId",
        "dispatchId"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "starting",
        "active",
        "review",
        "completed",
        "integrating",
        "integrated",
        "superseded",
        "failed",
        "abandoned",
        "unverifiable"
      ]
    },
    "supersededBy": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "fallbackReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}