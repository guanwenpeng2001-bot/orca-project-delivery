{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dispatch Wave Record",
  "type": "object",
  "required": ["waveId", "runSlug", "orcaRunId", "waveStartedAt", "waveRecordedAt", "taskCount", "tasks"],
  "properties": {
    "waveId": { "type": "string", "minLength": 1 },
    "runSlug": { "type": "string", "minLength": 1 },
    "orcaRunId": { "type": "string", "minLength": 1 },
    "waveStartedAt": { "type": "string", "minLength": 1 },
    "waveRecordedAt": { "type": "string", "minLength": 1 },
    "taskCount": { "type": "integer", "minimum": 0 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskKey"],
        "properties": {
          "taskKey": { "type": "string", "minLength": 1 },
          "requestedModel": { "type": ["string", "null"] },
          "requestedEffort": { "type": ["string", "null"] },
          "orcaTaskId": { "type": ["string", "null"] },
          "orcaDispatchId": { "type": ["string", "null"] },
          "startExit": { "type": ["integer", "null"] },
          "startState": { "type": ["string", "null"] },
          "launchRequested": { "$ref": "#/$defs/launchProfile" },
          "launchEffective": { "$ref": "#/$defs/launchProfile" },
          "recordedInLedger": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "parallelWindowSeconds": { "type": "number", "minimum": 0 },
    "note": { "type": "string" }
  },
  "$defs": {
    "launchProfile": {
      "type": ["object", "null"],
      "properties": {
        "agent": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "effort": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
