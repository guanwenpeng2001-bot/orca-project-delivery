{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinator Lock",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "coordinatorControlBranch",
    "coordinatorWorktree",
    "startedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "active",
        "released"
      ]
    },
    "coordinatorTerminalHandle": {
      "type": [
        "string",
        "null"
      ]
    },
    "coordinatorWorktreeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "livenessProbe": {
      "type": "string"
    },
    "hostProcessId": {
      "type": "integer"
    },
    "processId": {
      "type": "integer"
    },
    "host": {
      "type": "string"
    },
    "user": {
      "type": "string"
    },
    "coordinatorControlBranch": {
      "type": "string",
      "minLength": 1
    },
    "coordinatorWorktree": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "releasedAt": {
      "type": "string"
    },
    "releaseReason": {
      "type": "string"
    },
    "activeRun": {
      "type": [
        "string",
        "null"
      ]
    },
    "previousActiveRun": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
