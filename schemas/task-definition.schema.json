{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskKey",
    "title",
    "objective",
    "role",
    "skillDeliveryMode",
    "branch",
    "artifacts",
    "orca"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskKey": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "taskKind": {
      "enum": ["source", "read-only"],
      "default": "source"
    },
    "briefProfile": {
      "enum": ["standard", "review"],
      "default": "standard"
    },
    "agentsSections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "ATX heading numbers or titles; omitted or empty includes all applicable AGENTS files."
    },
    "reviewInput": {
      "type": "object",
      "required": ["baseSha", "branch", "diffCommand"],
      "properties": {
        "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$" },
        "branch": { "type": "string", "pattern": "\\S" },
        "diffCommand": { "type": "string", "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "reviewIncludes": {
      "type": "array",
      "items": { "enum": ["role", "skills", "requirements"] },
      "uniqueItems": true,
      "description": "Sections explicitly included in a review brief."
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "object",
      "required": [
        "required",
        "conditional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "skillDeliveryMode": {
      "enum": [
        "explicit-path",
        "inline-extract"
      ]
    },
    "inputs": {
      "type": "array"
    },
    "allowedScope": {
      "type": "array"
    },
    "forbiddenScope": {
      "type": "array"
    },
    "branch": {
      "type": "object",
      "required": [
        "delivery",
        "base",
        "work",
        "mergeTarget",
        "worktree"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "reportPath",
        "evidencePath"
      ]
    },
    "acceptance": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "orca": {
      "type": "object",
      "required": [
        "runId",
        "taskId",
        "dispatchId"
      ]
    },
    "applicableAgentsFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["briefProfile"], "properties": { "briefProfile": { "const": "review" } } },
      "then": { "required": ["reviewInput"] }
    }
  ],
  "additionalProperties": true
}
